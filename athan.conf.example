# /etc/default/athan -- single source of truth for athan-tv.
# After editing, run:  /opt/athan/apply-config.sh && systemctl restart lightdm

# ---- Location & calculation (https://aladhan.com/prayer-times-api) ----
LATITUDE=40.7128
LONGITUDE=-74.0060
METHOD=2            # 2 = ISNA (North America), 3 = MWL, 4 = Umm al-Qura, 5 = Egyptian ...
SCHOOL=0            # 0 = standard Asr, 1 = Hanafi Asr
TUNE=""             # optional per-prayer minute offsets, e.g. "0,2,0,0,0,0,0,0,0"

# ---- Display ----
TRANSLATION_LANGS="en"         # any of: en ur bn  (Arabic is always shown).
                               # Fewer languages = bigger text and no rotation.
TEXT_SCALE_MAX=1.6             # Ayah/Hadith text may grow to this multiple of the base size
                               # when it fits. 1.0 = old behaviour (shrink only). Try 1.7 for
                               # a bigger look; long passages still shrink so nothing clips.
AYAH_SECONDS=24                # minimum seconds the Ayah and Hadith slides stay up

# ---- Family calendar + lists (CalDAV / Radicale on Unraid) -- see docs/FAMILY.md ----
# This file holds a password: install.sh sets it to mode 600 (root only).
FAMILY=true
CALDAV_URL="http://192.168.1.3:5232/family/"   # the shared family account's home
CALDAV_USER=tv                                  # read-only account
CALDAV_PASS=""
FAMILY_DAYS=7
FAMILY_LISTS="Groceries, To-Do"                 # reminder lists to show, in order (empty = all)

# ---- Weather & alerts (Open-Meteo + US National Weather Service, uses LATITUDE/LONGITUDE) ----
WEATHER=true                   # true/false
FORECAST=true                  # 7-day forecast slide (needs WEATHER=true)

# ---- Live news video slide (YouTube live streams) ----
NEWS_VIDEO=true
NEWS_VIDEO_TITLE="US News Live"
NEWS_VIDEO_MUTED=true          # false = play the news with sound (skipped 1 min before to 6 min after each adhan)
NEWS_VIDEO_VOLUME=60           # 0-100, news loudness when not muted
NEWS_VIDEO_SECONDS=600         # how long the video stays on screen. 600 = a full 10-minute
                               # segment instead of a 90-second clip. See the note below on
                               # how this changes the share of screen time.
# Channels tried in order; the next is used if a stream is down or blocks embedding.
# Verify the IDs on this box first:  /opt/athan/yt-channel-id.sh @ABCNews @NBCNews @CBSNews
NEWS_VIDEO_CHANNELS="NBC News NOW|UCeY0bbntWzzVIaj2z3QigXg;NBC News|UChDKyKQ59fYz3JO2fl0Z6sg;ABC News|UCBi2mrWuNuyYy4gbM6fU18Q;CBS News|UC-SJ6nODDmufqBzPBwCvYvQ"

# ---- Markets slide (Yahoo Finance public chart data, ~15 min delayed) ----
MARKETS_SLIDE=true
# "Label|SYMBOL;..." using Yahoo symbols, max 8 shown. Examples: AAPL, MSFT, ^FTSE, BDT=X (USD to taka)
MARKETS="S&P 500|^GSPC;Dow Jones|^DJI;Nasdaq|^IXIC;10-Yr Treasury|^TNX;Crude Oil|CL=F;Gold|GC=F"
# Verify any symbol before adding it:  /opt/athan/test-symbols.py "Label|SYMBOL;..."

# ---- US financial news ticker ----
US_NEWS_TICKER=true            # true/false
US_NEWS_LABEL="US MARKETS"
# Verify any feed you add with:  /opt/athan/test-feeds.py "$US_NEWS_FEEDS"
US_NEWS_FEEDS="MarketWatch|https://feeds.content.dowjones.io/public/rss/mw_topstories;Yahoo Finance|https://finance.yahoo.com/news/rssindex;CNBC|https://www.cnbc.com/id/10000664/device/rss/rss.html"

# ---- Bengali news ticker ----
NEWS_TICKER=true               # true/false
# Feeds as "Name|URL;Name|URL" (RSS or Atom). Headlines only are shown.
NEWS_FEEDS="BBC বাংলা|https://feeds.bbci.co.uk/bengali/rss.xml;DW বাংলা|https://rss.dw.com/rdf/rss-ben-all"

# ---- Audio ----
# Find your device: grep -H "monitor_present\|monitor_name" /proc/asound/card*/eld*
#   HDMI/DisplayPort:  hdmi:CARD=HDMI,DEV=0
#   Headphone jack:    plughw:CARD=PCH,DEV=0
ALSA_DEVICE="hdmi:CARD=HDMI,DEV=0"
AUDIO=/opt/athan/adhan.mp3
SCALE=""                       # mpg123 volume scale (32768 = 100%). Empty = full volume.
FAJR_AUDIO=/opt/athan/adhan-fajr.mp3   # used for Fajr if the file exists
FAJR_SCALE=""                  # e.g. 13000 (~40%) for a quieter Fajr
