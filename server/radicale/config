# Radicale config for Unraid  (/mnt/user/appdata/radicale/config/config  ->  /config/config)
[server]
hosts = 0.0.0.0:5232
ssl = True
certificate = /config/tls/server.crt
key = /config/tls/server.key

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = bcrypt
# slow down password guessing
delay = 1

[rights]
type = from_file
file = /config/rights

[storage]
filesystem_folder = /data/collections

[logging]
level = warning
