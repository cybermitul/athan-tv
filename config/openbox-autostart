# Openbox autostart for the athan-tv kiosk user (~/.config/openbox/autostart)

# Keep the screen on
xset s off
xset -dpms
xset s noblank

# Hide the mouse pointer when idle
command -v unclutter >/dev/null && unclutter -idle 1 &

# After a power cut Chromium thinks it crashed and shows a "Restore pages?" bar -- clear that flag
PREFS="$HOME/.config/chromium/Default/Preferences"
[ -f "$PREFS" ] && sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' "$PREFS"

(
  # Wait (up to 2 min) for the nginx container before opening the page
  for _ in $(seq 1 60); do curl -fs -o /dev/null http://localhost:8080 && break; sleep 2; done
  # Relaunch Chromium if it ever exits
  while true; do
    chromium --kiosk --noerrdialogs --disable-infobars --disable-session-crashed-bubble \
      --disable-features=Translate --autoplay-policy=no-user-gesture-required \
      --check-for-update-interval=31536000 \
      http://localhost:8080
    sleep 5
  done
) &
